# Server
PORT=8383
# Used by fileUploadController for legacy URL fields (not required for Supabase URLs,
# but kept for compatibility). Set to your deployed backend URL, e.g. https://sakshi-backend.onrender.com
BACK_URL=http://localhost:8383

# Comma-separated list of allowed frontend origins (no trailing slash)
CORS_ORIGIN=http://localhost:3000,https://your-frontend.vercel.app

# MongoDB Atlas
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-url>/<db-name>?retryWrites=true&w=majority

# Auth
JWT_SECRET=replace-with-a-long-random-secret

# Supabase (used for file storage only — the app's database stays on MongoDB)
SUPABASE_URL=https://<your-project-ref>.supabase.co
# Service role key — server-side only, NEVER expose this in frontend code
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Storage bucket name — create this bucket as "Public" in Supabase before deploying
SUPABASE_BUCKET=sakshi-uploads
